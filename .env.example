# 복사해서 .env.local로 저장하고 값을 채운다. Vercel에는 같은 이름으로 Production 환경 변수에 등록한다.
# NEXT_PUBLIC_* 값은 빌드할 때 코드에 고정되므로, 바꾼 뒤에는 개발 서버 재시작 / Vercel 재배포가 필요하다.

# Supabase Dashboard > Project Settings > API (또는 Connect)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable 또는 anon key>

# 선택: Supabase Dashboard에서 활성화를 마친 소셜 provider만 쉼표로 (비우면 모든 소셜 버튼이 '준비 중' 안내)
NEXT_PUBLIC_ENABLED_SOCIAL_PROVIDERS=google,kakao
